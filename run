#!/usr/bin/env python3
"""Single entry point:  ./run <command> [options]   (see ./run --help)
Claude only uses this launcher. Heavy tools are never called directly."""
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))

from scripts.cli import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
