{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Scripting DNA",
  "type": "object",
  "required": ["type", "source", "hook", "structure", "pacing", "tone", "language", "cta", "confidence"],
  "properties": {
    "type": { "const": "scripting" },
    "source": {
      "type": "object", "required": ["job_id"],
      "properties": { "job_id": { "type": "string" }, "link": { "type": "string" }, "creator": { "type": "string" } }
    },
    "hook": {
      "type": "object", "required": ["kind", "duration_s"],
      "properties": { "kind": { "type": "string" }, "duration_s": { "type": "number" }, "pattern": { "type": "string" } }
    },
    "structure": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["beat", "purpose"],
        "properties": { "beat": { "type": "string" }, "purpose": { "type": "string" }, "share": { "type": "number" } }
      }
    },
    "pacing": {
      "type": "object",
      "properties": { "words_per_min": { "type": "number" }, "sentence_length": { "type": "string" } }
    },
    "tone": { "type": "string" },
    "language": { "type": "string" },
    "cta": {
      "type": "object", "required": ["style"],
      "properties": { "style": { "type": "string" }, "placement": { "type": "string" } }
    },
    "confidence": { "type": "object", "additionalProperties": { "enum": ["measured", "estimated"] } },
    "notes": { "type": "string" }
  }
}
