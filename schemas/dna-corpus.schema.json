{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "title": "Corpus DNA (many videos of one creator)",
 "type": "object",
 "required": [
  "type",
  "schema_version",
  "dna_type",
  "creator",
  "n_videos",
  "job_ids",
  "fields",
  "signature",
  "situational",
  "provisional"
 ],
 "properties": {
  "type": {
   "const": "corpus"
  },
  "schema_version": {
   "const": 2
  },
  "dna_type": {
   "enum": [
    "editing",
    "scripting",
    "sound"
   ]
  },
  "creator": {
   "type": "string"
  },
  "n_videos": {
   "type": "integer",
   "minimum": 1
  },
  "job_ids": {
   "type": "array",
   "items": {
    "type": "string"
   },
   "minItems": 1
  },
  "fields": {
   "type": "object"
  },
  "signature": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "situational": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "provisional": {
   "type": "boolean"
  },
  "min_videos_stable": {
   "type": "integer"
  },
  "notes": {
   "type": "string"
  }
 }
}