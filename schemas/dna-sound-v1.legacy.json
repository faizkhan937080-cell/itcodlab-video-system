{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Sound DNA",
  "type": "object",
  "required": ["type", "source", "bpm", "beat_sync", "loudness_db", "confidence"],
  "properties": {
    "type": { "const": "sound" },
    "source": {
      "type": "object", "required": ["job_id"],
      "properties": { "job_id": { "type": "string" }, "link": { "type": "string" }, "creator": { "type": "string" } }
    },
    "bpm": { "type": "number" },
    "beat_sync": {
      "type": "object", "required": ["share_within_80ms"],
      "properties": { "share_within_80ms": { "type": "number", "minimum": 0, "maximum": 1 }, "notes": { "type": "string" } }
    },
    "voice_music_balance": { "type": "string" },
    "loudness_db": {
      "type": "object", "required": ["mean"],
      "properties": { "mean": { "type": "number" }, "max": { "type": "number" } }
    },
    "silence_usage": { "type": "string" },
    "confidence": { "type": "object", "additionalProperties": { "enum": ["measured", "estimated"] } },
    "notes": { "type": "string" }
  }
}
