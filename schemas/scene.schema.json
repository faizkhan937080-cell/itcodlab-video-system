{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Scene plan (input of the Remotion render)",
  "type": "object",
  "required": [
    "title",
    "fps",
    "orientation",
    "scenes"
  ],
  "properties": {
    "title": {
      "type": "string"
    },
    "fps": {
      "type": "integer",
      "minimum": 24,
      "maximum": 120
    },
    "orientation": {
      "enum": [
        "portrait",
        "landscape"
      ]
    },
    "dna": {
      "type": "object",
      "properties": {
        "editing": {
          "type": "string"
        },
        "scripting": {
          "type": "string"
        },
        "sound": {
          "type": "string"
        }
      }
    },
    "brand": {
      "type": "object",
      "properties": {
        "colors": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^#[0-9A-Fa-f]{6}$"
          }
        },
        "font": {
          "type": "string"
        }
      }
    },
    "grain": {
      "type": "boolean"
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 60,
      "items": {
        "type": "object",
        "required": [
          "id",
          "duration_s",
          "template"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "duration_s": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 60
          },
          "template": {
            "enum": [
              "title",
              "kinetic_text",
              "banner",
              "image",
              "lower_third",
              "video"
            ]
          },
          "props": {
            "type": "object"
          },
          "transition_in": {
            "type": "object",
            "properties": {
              "type": {
                "enum": [
                  "cut",
                  "fade",
                  "slide",
                  "zoom"
                ]
              },
              "duration_s": {
                "type": "number",
                "minimum": 0,
                "maximum": 2
              }
            }
          }
        }
      }
    },
    "output": {
      "type": "object",
      "required": [
        "width",
        "height"
      ],
      "description": "Optional explicit output size; normally derived from raw video clips.",
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 256,
          "maximum": 7680,
          "multipleOf": 2
        },
        "height": {
          "type": "integer",
          "minimum": 256,
          "maximum": 7680,
          "multipleOf": 2
        }
      }
    },
    "audio": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "required": [
          "src"
        ],
        "properties": {
          "src": {
            "type": "string"
          },
          "at_s": {
            "type": "number",
            "minimum": 0
          },
          "trim_start_s": {
            "type": "number",
            "minimum": 0
          },
          "duration_s": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "volume": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "fade_in_s": {
            "type": "number",
            "minimum": 0
          },
          "fade_out_s": {
            "type": "number",
            "minimum": 0
          }
        }
      }
    },
    "audio_target_lufs": {
      "type": "number",
      "minimum": -40,
      "maximum": -5
    }
  }
}