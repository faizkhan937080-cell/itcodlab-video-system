{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Scene plan (input of the Remotion render)",
  "type": "object",
  "required": [
    "title",
    "fps",
    "orientation",
    "scenes"
  ],
  "properties": {
    "title": {
      "type": "string"
    },
    "fps": {
      "type": "integer",
      "minimum": 24,
      "maximum": 120
    },
    "orientation": {
      "enum": [
        "portrait",
        "landscape"
      ]
    },
    "dna": {
      "type": "object",
      "properties": {
        "editing": {
          "type": "string"
        },
        "scripting": {
          "type": "string"
        },
        "sound": {
          "type": "string"
        }
      }
    },
    "brand": {
      "type": "object",
      "properties": {
        "colors": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^#[0-9A-Fa-f]{6}$"
          }
        },
        "font": {
          "type": "string"
        }
      }
    },
    "grain": {
      "type": "boolean"
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 60,
      "items": {
        "type": "object",
        "required": [
          "id",
          "duration_s",
          "template"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "duration_s": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 60
          },
          "template": {
            "enum": [
              "title",
              "kinetic_text",
              "banner",
              "image",
              "lower_third",
              "video",
              "counter",
              "bar_chart",
              "checklist",
              "split_compare",
              "quote",
              "stroke",
              "paper_cutout",
              "lottie",
              "audio_bars",
              "meme_text",
              "sticker",
              "med",
              "clean_bg",
              "clean_card"
            ]
          },
          "props": {
            "type": "object"
          },
          "transition_in": {
            "type": "object",
            "properties": {
              "type": {
                "enum": [
                  "cut",
                  "fade",
                  "slide",
                  "zoom",
                  "wipe",
                  "slide_up",
                  "flip",
                  "iris",
                  "clock_wipe",
                  "whip"
                ]
              },
              "duration_s": {
                "type": "number",
                "minimum": 0,
                "maximum": 2
              },
              "overlap": {
                "type": "boolean"
              }
            }
          },
          "zoom": {
            "type": "array",
            "maxItems": 200,
            "description": "Zoom/punch-in keyframes (scene seconds). Remotion interpolates; scripts/fx.py punch_keys() builds beat-synced ones.",
            "items": {
              "type": "object",
              "required": [
                "at_s",
                "scale"
              ],
              "properties": {
                "at_s": {
                  "type": "number",
                  "minimum": 0
                },
                "scale": {
                  "type": "number",
                  "minimum": 1,
                  "maximum": 1.6
                },
                "x": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "y": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "ease": {
                  "enum": [
                    "linear",
                    "out",
                    "in",
                    "inout"
                  ]
                }
              }
            }
          },
          "overlays": {
            "type": "array",
            "maxItems": 12,
            "items": {
              "type": "object",
              "required": [
                "template"
              ],
              "properties": {
                "template": {
                  "enum": [
                    "title",
                    "kinetic_text",
                    "banner",
                    "image",
                    "lower_third",
                    "video",
                    "counter",
                    "bar_chart",
                    "checklist",
                    "split_compare",
                    "quote",
                    "stroke",
                    "paper_cutout",
                    "lottie",
                    "audio_bars",
                    "meme_text",
                    "sticker",
                    "clean_bg",
                    "clean_card"
                  ]
                },
                "props": {
                  "type": "object"
                },
                "start_s": {
                  "type": "number",
                  "minimum": 0
                },
                "end_s": {
                  "type": "number",
                  "minimum": 0
                },
                "box": {
                  "type": "object",
                  "required": [
                    "x",
                    "y",
                    "w",
                    "h"
                  ],
                  "properties": {
                    "x": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "y": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "w": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "h": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    }
                  }
                },
                "follow": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "t",
                      "x",
                      "y",
                      "w",
                      "h"
                    ]
                  }
                }
              }
            }
          },
          "fx": {
            "type": "array",
            "maxItems": 24,
            "items": {
              "type": "object",
              "required": [
                "type",
                "start_s"
              ],
              "properties": {
                "type": {
                  "enum": [
                    "shake",
                    "zoom_punch",
                    "flash",
                    "rgb_split",
                    "glitch",
                    "freeze"
                  ]
                },
                "start_s": {
                  "type": "number",
                  "minimum": 0
                },
                "dur_s": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 10
                },
                "strength": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 2
                },
                "auto": {
                  "type": "boolean"
                }
              }
            }
          },
          "underlays": {
            "type": "array",
            "maxItems": 24,
            "items": {
              "type": "object",
              "required": [
                "template"
              ],
              "properties": {
                "template": {
                  "enum": [
                    "title",
                    "kinetic_text",
                    "banner",
                    "image",
                    "lower_third",
                    "video",
                    "counter",
                    "bar_chart",
                    "checklist",
                    "split_compare",
                    "quote",
                    "stroke",
                    "paper_cutout",
                    "lottie",
                    "audio_bars",
                    "meme_text",
                    "sticker",
                    "clean_bg",
                    "clean_card"
                  ]
                },
                "props": {
                  "type": "object"
                },
                "start_s": {
                  "type": "number",
                  "minimum": 0
                },
                "end_s": {
                  "type": "number",
                  "minimum": 0
                },
                "box": {
                  "type": "object",
                  "required": [
                    "x",
                    "y",
                    "w",
                    "h"
                  ],
                  "properties": {
                    "x": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "y": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "w": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "h": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    }
                  }
                },
                "follow": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "t",
                      "x",
                      "y",
                      "w",
                      "h"
                    ]
                  }
                }
              }
            },
            "description": "graphics drawn UNDER the scene body (e.g. behind a green-screen keyed person)"
          }
        }
      }
    },
    "output": {
      "type": "object",
      "required": [
        "width",
        "height"
      ],
      "description": "Optional explicit output size; normally derived from raw video clips.",
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 256,
          "maximum": 7680,
          "multipleOf": 2
        },
        "height": {
          "type": "integer",
          "minimum": 256,
          "maximum": 7680,
          "multipleOf": 2
        }
      }
    },
    "audio": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "required": [
          "src"
        ],
        "properties": {
          "src": {
            "type": "string"
          },
          "at_s": {
            "type": "number",
            "minimum": 0
          },
          "trim_start_s": {
            "type": "number",
            "minimum": 0
          },
          "duration_s": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "volume": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "fade_in_s": {
            "type": "number",
            "minimum": 0
          },
          "fade_out_s": {
            "type": "number",
            "minimum": 0
          },
          "role": {
            "enum": [
              "voice",
              "music",
              "sfx"
            ]
          },
          "clean": {
            "type": "boolean",
            "description": "voice only: run the voice clean-up chain (default true)"
          },
          "clean_level": {
            "enum": [
              "normal",
              "light"
            ]
          },
          "duck_gain": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "duck": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "from_s",
                "to_s"
              ]
            }
          }
        }
      }
    },
    "audio_target_lufs": {
      "type": "number",
      "minimum": -40,
      "maximum": -5
    },
    "captions": {
      "type": "array",
      "maxItems": 2000,
      "items": {
        "type": "object",
        "required": [
          "text",
          "start_s",
          "end_s"
        ],
        "properties": {
          "text": {
            "type": "string"
          },
          "start_s": {
            "type": "number",
            "minimum": 0
          },
          "end_s": {
            "type": "number",
            "minimum": 0
          },
          "words": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "text",
                "start_s",
                "end_s"
              ],
              "properties": {
                "text": {
                  "type": "string"
                },
                "start_s": {
                  "type": "number",
                  "minimum": 0
                },
                "end_s": {
                  "type": "number",
                  "minimum": 0
                }
              }
            }
          }
        }
      }
    },
    "caption_style": {
      "type": "object",
      "properties": {
        "position": {
          "enum": [
            "bottom",
            "center",
            "top"
          ]
        },
        "max_words": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "highlight": {
          "type": "string"
        },
        "size": {
          "type": "number",
          "minimum": 0.4,
          "maximum": 2.5
        },
        "look": {
          "enum": [
            "tiktok",
            "clean"
          ],
          "description": "clean = dark bold word on light page, no stroke (ref reel-Dfj6PH9tIBB)"
        },
        "y": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "clean look: centre of the caption line, fraction of height"
        }
      }
    },
    "step_fps": {
      "type": "number",
      "minimum": 4,
      "maximum": 24
    },
    "texture": {
      "type": "object",
      "required": [
        "src"
      ],
      "properties": {
        "src": {
          "type": "string"
        },
        "opacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "blend": {
          "enum": [
            "multiply",
            "overlay",
            "soft-light"
          ]
        }
      }
    },
    "grade": {
      "type": "object",
      "description": "Colour grade of the FOOTAGE and pictures (never text/graphics). Default when absent = auto.",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": [
            "auto",
            "natural",
            "off"
          ]
        },
        "ref": {
          "type": "string",
          "description": "Drive path of a reel's grade.json (the look to match)"
        },
        "strength": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "vignette": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "grain_src": {
      "type": "string"
    }
  }
}
