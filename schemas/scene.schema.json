{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Scene plan (input of the Remotion render)",
  "type": "object",
  "required": ["title", "fps", "orientation", "scenes"],
  "properties": {
    "title": { "type": "string" },
    "fps": { "type": "integer", "minimum": 24, "maximum": 60 },
    "orientation": { "enum": ["portrait", "landscape"] },
    "dna": {
      "type": "object",
      "properties": { "editing": { "type": "string" }, "scripting": { "type": "string" }, "sound": { "type": "string" } }
    },
    "brand": {
      "type": "object",
      "properties": {
        "colors": { "type": "object", "additionalProperties": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" } },
        "font": { "type": "string" }
      }
    },
    "grain": { "type": "boolean" },
    "scenes": {
      "type": "array", "minItems": 1, "maxItems": 60,
      "items": {
        "type": "object",
        "required": ["id", "duration_s", "template"],
        "properties": {
          "id": { "type": "string" },
          "duration_s": { "type": "number", "exclusiveMinimum": 0, "maximum": 60 },
          "template": { "enum": ["title", "kinetic_text", "banner", "image", "lower_third"] },
          "props": { "type": "object" },
          "transition_in": {
            "type": "object",
            "properties": {
              "type": { "enum": ["cut", "fade", "slide", "zoom"] },
              "duration_s": { "type": "number", "minimum": 0, "maximum": 2 }
            }
          }
        }
      }
    }
  }
}
