{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Job file (dropped in Drive jobs/inbox/<id>.json)",
  "type": "object",
  "required": [
    "id",
    "type"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{3,60}$"
    },
    "type": {
      "enum": [
        "analyze",
        "render",
        "style"
      ]
    },
    "created": {
      "type": "string"
    },
    "command_text": {
      "type": "string"
    },
    "link": {
      "type": "string"
    },
    "file": {
      "type": "string",
      "description": "Drive path of a reference already in Drive, e.g. input/references/x.mp4"
    },
    "mode": {
      "enum": [
        "video",
        "audio",
        "both"
      ]
    },
    "target": {
      "type": "string",
      "pattern": "^(general|creator:auto|creator:[A-Za-z0-9_.-]{2,40})$"
    },
    "reel_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{5,20}$",
      "description": "Instagram shortcode: the permanent folder name of this reel"
    },
    "gate1_approved_by_user": {
      "const": true
    },
    "plan_prefix": {
      "type": "string",
      "description": "render jobs: plans are jobs/plans/<id>-v<N>.json"
    },
    "bulk": {
      "type": "boolean",
      "description": "Part of a batch: measured only, no gates, not counted in the daily Claude cap."
    },
    "batch": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{3,60}$"
    },
    "batch_size": {
      "type": "integer",
      "minimum": 1,
      "maximum": 200
    },
    "out": {
      "type": "string",
      "description": "style job: Drive folder for style_record.json"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "const": "analyze"
          }
        }
      },
      "then": {
        "required": [
          "mode",
          "target",
          "gate1_approved_by_user"
        ],
        "anyOf": [
          {
            "required": [
              "link"
            ]
          },
          {
            "required": [
              "file"
            ]
          }
        ]
      }
    }
  ]
}
